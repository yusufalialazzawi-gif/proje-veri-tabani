# ---------------------------------------------------------------------------
# .env ÖRNEĞİ — bu dosyayı kopyalayıp ".env" adıyla kaydedin ve değerleri doldurun.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Windows (Git Bash):    cp .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# .env DOSYASINI ASLA GitHub'a YÜKLEMEYİN. .gitignore zaten içeriyor.
# ---------------------------------------------------------------------------

# --- PostgreSQL bağlantısı -------------------------------------------------
# Yöntem 1: tek bir bağlantı dizesi (DATABASE_URL tanımlıysa önceliklidir)
# DATABASE_URL=postgresql://postgres:sifreniz@localhost:5432/nutrition_tracker

# Yöntem 2: ayrı alanlar
PGHOST=localhost
PGPORT=5432
PGDATABASE=nutrition_tracker
PGUSER=postgres
PGPASSWORD=degistirin_bu_bir_sir

# Bağlantı havuzu
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000

# --- Uygulama ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Statik frontend klasörü (mutlak ya da proje köküne göre göreli yol)
FRONTEND_DIR=frontend

# --- Oturum güvenliği -------------------------------------------------------
# Oturum süresi (gün). Oturumlar veritabanında tutulur, bu süre sonunda düşer.
SESSION_TTL_DAYS=7

# Oturum çerezi adı
SESSION_COOKIE_NAME=nt_session

# Üretimde (NODE_ENV=production) çerez yalnızca HTTPS üzerinden gönderilir.
# Yerel geliştirmede http://localhost kullandığınız için false kalmalıdır.
COOKIE_SECURE=false

# --- Kimlik doğrulama zorlaştırma -------------------------------------------
# Giriş denemesi hız sınırı: pencere (dk) ve pencere başına en fazla deneme
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX_ATTEMPTS=10
REGISTER_RATE_MAX_ATTEMPTS=5

# --- Hesaplama davranışı ----------------------------------------------------
# Haftalık ortalamanın "yeterli veri" sayılması için gereken gün sayısı.
# Veri girilmeyen günler sıfır tüketim SAYILMAZ; yalnızca kayıt olan günler
# ortalamaya girer. Bu eşik, ortalamanın güvenilirliğini raporlamak içindir.
WEEKLY_MIN_COVERAGE_DAYS=4

# Sebze/meyve/baklagil için 1 porsiyon = kaç gram.
# Dayanak: WHO "günde en az 400 g sebze+meyve = 5 porsiyon (80 g)".
SERVING_GRAMS=80
