{
  "name": "nutrition-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "SQL veritabanli kalori ve besin takip sistemi (Node.js + Express + PostgreSQL)",
  "type": "commonjs",
  "main": "backend/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "db:create": "psql -U postgres -c \"CREATE DATABASE nutrition_tracker ENCODING 'UTF8'\"",
    "db:schema": "psql -U postgres -d nutrition_tracker -v ON_ERROR_STOP=1 -f database/schema.sql",
    "db:views": "psql -U postgres -d nutrition_tracker -v ON_ERROR_STOP=1 -f database/queries.sql",
    "db:seed": "psql -U postgres -d nutrition_tracker -v ON_ERROR_STOP=1 -f database/seed.sql",
    "db:setup": "npm run db:create && npm run db:schema && npm run db:views && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
